rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Danh sách UID được phép quản trị — cập nhật khi thêm tài khoản thứ 2.
    function isAdmin() {
      return request.auth != null &&
        request.auth.uid in [
          'BxRGkox6sYZhwSM7OOjqu42J9bH2'
        ];
    }

    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.size < 3 * 1024 * 1024;
    }

    match /branding/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.size < 3 * 1024 * 1024;
    }
  }
}
