rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Danh sách UID được phép quản trị — cập nhật khi thêm tài khoản thứ 2.
    function isAdmin() {
      return request.auth != null &&
        request.auth.uid in [
          'BxRGkox6sYZhwSM7OOjqu42J9bH2'
        ];
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Sự kiện chatbot (khách dùng widget chat, không cần đăng nhập) — ghi
    // công khai để widget tạo/nối thêm sự kiện vào phiên của chính khách
    // đó, chỉ admin mới đọc được để xem lại trong trang quản trị.
    match /chatSessions/{sessionId} {
      allow create, update: if true;
      allow read, delete: if isAdmin();
    }
  }
}
